# ─────────────────────────────────────────────────────────────
# DiveFinder — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. No secret belongs in client-exposed
# (NEXT_PUBLIC_*) variables except keys that are safe to ship to
# the browser (Supabase anon key, a public map token).
# ─────────────────────────────────────────────────────────────

# Supabase (required)
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, used by seed/admin scripts and the
# service-role Supabase client in src/lib/supabase/admin.ts. Never
# expose this in client code or a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Map provider (optional — the map screen falls back to a static
# list/grid view with a clear notice if this is not set)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics (optional — analytics abstraction no-ops if unset)
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
